version: "3.8"

services:
  meilisearch-0.25.2:
    container_name: meilisearch
    image: "getmeili/meilisearch:v0.25.2"
    ports:
      - "7700:7700"
    environment:
      - MEILI_ENV=development #production
      - MEILI_MASTER_KEY=test_api_key
      - MEILI_DUMPS_DIR=./dumps/
      - MEILI_DB_PATH=data.ms/
      - MEILI_LOG_LEVEL=INFO #ERROR, WARN, INFO, DEBUG, OR TRACE
      - MEILI_NO_ANALYTICS=true
      - MEILI_NO_SENTRY=true
    volumes:
      - ./.meilisearch/storage:/data.ms
      - ./.meilisearch/dumps:/dumps
    restart: unless-stopped
  redis:
    image: redis:5.0
    container_name: Redis
    ports:
      - 6379:6379
    command: --requirepass password
    restart: unless-stopped
