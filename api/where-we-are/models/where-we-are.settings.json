{
  "kind": "collectionType",
  "collectionName": "where_we_ares",
  "info": {
    "name": "Onde estamos",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
