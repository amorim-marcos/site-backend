{
  "kind": "collectionType",
  "collectionName": "where_we_ares",
  "info": {
    "name": "Where we are",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string",
      "required": true
    },
    "our_place_information": {
      "type": "component",
      "repeatable": false,
      "component": "our-place-information.our-place-information"
    },
    "google_maps_url": {
      "type": "text",
      "required": true
    },
    "state": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string",
      "required": true
    },
    "inauguration_soon": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
