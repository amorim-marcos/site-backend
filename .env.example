HOST=0.0.0.0
PORT=1337
URL='http://localhost:1337'

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=berneck
DATABASE_USERNAME=dev
DATABASE_PASSWORD=devpass

MEILI_HOST='http://localhost:7700/'
MEILISEARCH_API_KEY='test_api_key'

REDIS_HOST='127.0.0.1'
REDIS_PORT=6379
REDIS_PASSWORD='password'

BULL_QUEUE_CONCURRENCY=5

SE_AUTH_TOKEN="<token-do-se-por-ambiente>"
SE_WSDL_URL = "https://portal-teste.berneck.com.br/se/ws/wf_ws.php?wsdl"
SE_WSDL_LOCATION = "https://portal-teste.berneck.com.br/apigateway/se/ws/wf_ws.php"
SE_ID_PROCESS = "MKT001"
SE_USER_ID = "faleconosco"
SE_ACTIVITY_ID = "ATV.0419"

# --- Ouvidoria (upload de arquivos) ---
# Exemplos da QAS; os valores de produção vêm da TI Berneck.
OUVIDORIA_ENABLED=false
# Nome do canal que usa o fluxo da Ouvidoria. Com OUVIDORIA_ENABLED=true ele e suas traduções passam a usar o formulário novo; desligando, voltam ao antigo.
OUVIDORIA_CHANNEL_NAME="Ouvidoria"
# true = identificação opcional. O envio sempre exige o relato ou um arquivo.
OUVIDORIA_ALLOW_ANONYMOUS=true
# Obrigatório: gerar com `openssl rand -hex 32`. Vazio mantém a rota bloqueada (503).
OUVIDORIA_FORM_TOKEN_SECRET=
OUVIDORIA_MAX_FILE_MB=50

# Temporário dos uploads (0700, criado na subida). Disco LOCAL, nunca o EFS (/var/www/html).
# O usuário do PM2 precisa poder escrever. Sobras com mais de MAX_AGE_MIN são removidas a cada SWEEP_MIN.
OUVIDORIA_TEMP_DIR="/home/admin/data/ouvidoria-tmp"
OUVIDORIA_TEMP_MAX_AGE_MIN=60
OUVIDORIA_TEMP_SWEEP_MIN=15
# Envios simultâneos aceitos; o excedente recebe 503.
OUVIDORIA_MAX_CONCURRENT_UPLOADS=3

# Bucket dos anexos. Sem chaves, o SDK usa a role da instância. Chaves só em .env (nunca no repo).
OUVIDORIA_S3_BUCKET=
OUVIDORIA_S3_REGION="sa-east-1"
OUVIDORIA_S3_ACCESS_KEY_ID=
OUVIDORIA_S3_SECRET_ACCESS_KEY=
# Prefixo opcional das chaves no bucket (vazio = raiz).
OUVIDORIA_S3_PREFIX=
# Endereço do download seguro (Cognito + MFA). A URL entregue ao SE é <base>/<chave>.
OUVIDORIA_ATTACHMENT_BASE_URL="https://anexosqas.berneck.com.br/arquivo"

# Espera a tag de varredura do GuardDuty antes de entregar o link ao SE (exige s3:GetObjectTagging).
OUVIDORIA_WAIT_SCAN=true
OUVIDORIA_SCAN_TIMEOUT_MIN=10
OUVIDORIA_SCAN_POLL_SECONDS=10

OUVIDORIA_RATE_IP_MAX=3
OUVIDORIA_RATE_IP_WINDOW_MIN=10
OUVIDORIA_RATE_GLOBAL_MAX_HOUR=10
OUVIDORIA_FORM_MIN_SECONDS=3
OUVIDORIA_FORM_MAX_AGE_MIN=60
OUVIDORIA_JOB_ATTEMPTS=8
OUVIDORIA_JOB_BACKOFF_SECONDS=30
# Cobre a espera da varredura e as chamadas ao SE.
OUVIDORIA_JOB_TIMEOUT_MIN=20
OUVIDORIA_CONCURRENCY=2
SE_OUVIDORIA_PROCESS_ID="CPL002"
SE_OUVIDORIA_USER_ID="ouvidoria"
SE_OUVIDORIA_ENTITY_ID="ouvidoria"
SE_OUVIDORIA_ACTIVITY_ID="ATV.0591"
SE_OUVIDORIA_ACTION_SEQUENCE="1"
# Opcional: atributo da entidade que recebe a situação do anexo (ex.: retido). Sem ele, só vai ao log.
SE_OUVIDORIA_ATTACHMENT_NOTE_ATTRIBUTE=

# IP real atrás de proxy. Ligar só depois de confirmar o que a borda faz com X-Forwarded-For.
# PROXY_TRUSTED_HOPS = quantos proxies confiáveis acrescentam ao header (ALB = 1; CloudFront + ALB = 2).
PROXY_ENABLED=false
PROXY_TRUSTED_HOPS=1
