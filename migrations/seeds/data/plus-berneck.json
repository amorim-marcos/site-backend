    "test_points": [
        {
            "id": 1,
            "point_text": "Pesamos e medimos a espessura dos corpos de prova: amostras de 15mm de MDF e MDP Standard, e MDF e MDP Plus, todas sem revestimento."
        },
        {
            "id": 2,
            "point_text": "Acondicionamos as amostras por 16 dias em estufa com temperatura constante de 25ºC e umidade relativa do ar de 90%."
        },
        {
            "id": 3,
            "point_text": "Após este período, novamente pesamos e medidos a espessura dos corpos de prova."
        }   
    ],
    "important_points": [
        {
            "id": 1,
            "point_text": "Utilize a linha BERNECK PLUS em áreas que não tenham contato direto com água."
        },
        {
            "id": 2,
            "point_text": "É indispensável proteger todas as faces e bordas do painel contra ação da umidade, inclusive as não aparentes, pois este produto não é isento a mofo."
        },
        {
            "id": 3,
            "point_text": "Ambientes com focos de cupim devem ser tratados antes da instalação de qualquer móvel, inclusive os com a linha PLUS BERNECK®."
        }   
    ],
